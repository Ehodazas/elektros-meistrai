# Copy to .env and fill in. Never commit .env.

# Public site URL (no trailing slash). Used for canonical URLs, Open Graph and sitemap.xml.
SITE_URL=https://www.jusu-domenas.lt

# Base path. "/" for Netlify, Vercel or your own domain.
# For GitHub Pages project site: "/<repository-name>/"
BASE_PATH=/

# Form endpoint. Leave empty = form runs in DEMONSTRATION mode (nothing is sent).
# Any service that accepts a JSON POST works, e.g. Formspree: https://formspree.io/f/xxxxxxx
VITE_FORM_ENDPOINT=
